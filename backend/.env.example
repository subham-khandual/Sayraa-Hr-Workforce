# Backend environment variables (copy to .env and fill with real values)

PORT=5000
MONGODB_URI=mongodb://localhost:27017/sayraa_hr
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development

# Email (Gmail SMTP) — used for OTP, assessment, interview & offer emails
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# SMTP fallback (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
